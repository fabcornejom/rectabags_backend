# Copiar como config/application-local.properties (ignorado por Git).
# Completar con las credenciales propias; no reutilizar valores de otros equipos.
# También se pueden proporcionar DB_PASSWORD y JWT_SECRET como variables de entorno.
# DB_PASSWORD=
# JWT_SECRET=
# Opcional: origenes exactos separados por comas (sin rutas ni barra final).
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
